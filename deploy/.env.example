# Copy to deploy/.env. Development values only.
TESSERA_DEV_SECRET=devsecret-devsecret-devsecret-0000
# Address browsers use for media: 127.0.0.1 for this machine only, the LAN IP for other devices.
TESSERA_NODE_IP=127.0.0.1
