# Copy to deploy/.env. Development values only.
TESSERA_DEV_SECRET=devsecret-devsecret-devsecret-0000
# Address browsers use for media: 127.0.0.1 for this machine only, the LAN IP for other devices.
TESSERA_NODE_IP=127.0.0.1
# Optional build settings (empty = the public defaults).
# NPMRC=~/.npmrc
# GOPROXY=https://goproxy.io,direct
# NPM_REGISTRY=https://registry.npmmirror.com/

# Optional TURN for clients (all nodes): comma-separated URLs, then either fixed credentials
# (TURN_USERNAME/TURN_CREDENTIAL) or a shared secret (TURN_SECRET, per-session credentials).
# FORCE_RELAY=true makes browsers use only TURN (with only TCP/TLS URLs: TURN over TCP).
# TURN_URLS=turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# TURN_SECRET=
# FORCE_RELAY=true
